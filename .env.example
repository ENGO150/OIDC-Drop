# Numeric GitHub owner ID (user or organization), not the login name.
REPOSITORY_OWNER_ID=12345678

# Repository ID=file prefix. Separate multiple repositories with commas.
ASSET_PREFIXES=987654321=myapp

# Exact GitHub OIDC subjects allowed to upload. Branch subjects only.
ALLOWED_SUBS=repo:YOUR_OWNER/YOUR_REPO:ref:refs/heads/main

# Artifact variants accepted in /upload/{variant}.
ALLOWED_VARIANTS=linux-amd64,linux-arm64
